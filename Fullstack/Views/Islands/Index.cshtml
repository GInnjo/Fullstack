@using Fullstack.Models.Static
@using Fullstack.Components
@model string[,]
@{
    string[][] jaggedFishTable = ConvertToJagged(Model);
}

<div class="chart-container">
    <img src="~/vesi.png" alt="water" class="chart-graphics img" id="water-img"/>
    <component type="typeof(FishMapper)" 
           render-mode="Server" 
           param-FishTable="jaggedFishTable" />
    <img src="~/maa.png" alt="land" class="chart-graphics img" id="land-img" />
</div>

<component type="typeof(Home)" render-mode="Server" />


@functions {
    public static string[][] ConvertToJagged(string[,] array2D)
    {
        int rows = array2D.GetLength(0);
        int cols = array2D.GetLength(1);
        var jagged = new string[rows][];

        for (int i = 0; i < rows; i++)
        {
            jagged[i] = new string[cols];
            for (int j = 0; j < cols; j++)
            {
                jagged[i][j] = array2D[i, j];
            }
        }

        return jagged;
    }
}

